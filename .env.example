# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo  # Default model, can be changed to other supported models

# System Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
DATA_CACHE_DIR=data/cache
ANALYSIS_OUTPUT_DIR=data/analysis

# Trading Parameters
DEFAULT_TIMEFRAME=1h  # Default trading timeframe
DEFAULT_LOOKBACK_DAYS=7  # Default analysis period in days
MAX_POSITIONS=3  # Maximum number of concurrent trading positions
RISK_PERCENTAGE=2  # Maximum risk per trade as percentage of portfolio

# Database Configuration (for future use)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=crypto_trading
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# Web Interface Settings (for future use)
WEB_HOST=0.0.0.0
WEB_PORT=8000
DEBUG_MODE=False

# Trading Parameters
MAX_POSITION_SIZE=0.1  # Maximum position size as a fraction of total capital
STOP_LOSS_PERCENTAGE=0.02  # Stop loss as a fraction of position
TAKE_PROFIT_PERCENTAGE=0.06  # Take profit as a fraction of position

# Risk Management
MAX_TRADES_PER_DAY=5
MAX_DRAWDOWN_PERCENTAGE=0.15 